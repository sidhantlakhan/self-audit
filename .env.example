# ---- Required ----
# Postgres connection. Run `npm run db:migrate` once after setting it.
DATABASE_URL=postgres://amalthea:amalthea@localhost:5432/amalthea
# Set to "require" for managed Postgres that needs TLS.
PGSSLMODE=

# Public base URL of this app (used in PDF, WhatsApp and email links, and by the retry job).
APP_URL=https://scorecard.example.in

# Claude API key for the AI-written report (model: claude-opus-5-5).
ANTHROPIC_API_KEY=

# Chromium binary used to render the two-page PDF.
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Shared secret for GET /api/cron/retry-reports (send as "Authorization: Bearer <secret>").
CRON_SECRET=

# Salt for hashing visitor network addresses (rate limiting).
IP_HASH_SALT=

# ---- Delivery (each channel is skipped when not configured) ----
# WhatsApp Cloud API: an approved template with a DOCUMENT header and body {{1}} first name, {{2}} score.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v23.0

# Email via Resend, from a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM="Amalthea Consultancy <scorecard@your-domain.in>"

# ---- Business facts shown on the site (defaults are the design's "to be confirmed" values) ----
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_PRICE_SELF_AUDIT=
NEXT_PUBLIC_PRICE_CONSULTANT_AUDIT=
NEXT_PUBLIC_STORAGE_REGION=
NEXT_PUBLIC_WEBINAR_URL=
NEXT_PUBLIC_BOOKING_URL=

# ---- Limits ----
SCORECARD_STARTS_PER_DEVICE=5
SCORECARD_STARTS_PER_IP=25
