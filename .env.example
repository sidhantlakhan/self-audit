# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public base URL (used for canonical URL, resume links, report links)
APP_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────
# Production / staging: a PostgreSQL connection string.
#   DATABASE_URL=postgres://user:password@host:5432/ai_readiness
# Local development without installing Postgres: embedded PGlite persisted on disk.
#   DATABASE_URL=pglite:./.pglite
# Throwaway in-memory database (tests): pglite:memory
DATABASE_URL=pglite:./.pglite

# ── Secrets (generate each with: openssl rand -hex 32) ─────────────────
SESSION_SECRET=replace-with-32-plus-random-bytes
RESUME_TOKEN_SECRET=replace-with-32-plus-random-bytes
ADMIN_AUTH_SECRET=replace-with-32-plus-random-bytes
# Shared secret used to verify consultation-booking webhooks (HMAC-SHA256)
BOOKING_WEBHOOK_SECRET=replace-with-32-plus-random-bytes

# ── AI interpretation layer ─────────────────────────────────────────────
# anthropic = real model call; mock = deterministic local generator (dev/tests only)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=60000

# ── Consultation booking ────────────────────────────────────────────────
# Any scheduling page that accepts query-string prefill (Cal.com, Calendly, etc.)
BOOKING_URL=https://example.com/book-consultation

# ── Notifications (all optional; the assessment never depends on them) ──
# console = write to the notification outbox + server log; resend = Resend HTTP API; none = disabled
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=diagnostic@example.com
# console | none
WHATSAPP_PROVIDER=none

# ── Analytics ───────────────────────────────────────────────────────────
# internal = events stored in the database; none = disabled
ANALYTICS_PROVIDER=internal

# ── Runtime ─────────────────────────────────────────────────────────────
WORKER_ENABLED=true
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=0
# Admin bootstrap (used only by `npm run seed` in non-production and `npm run admin:create`)
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=
